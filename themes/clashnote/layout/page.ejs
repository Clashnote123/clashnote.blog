<%
page.extraHead = (page.extraHead || '') + jsonld({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashnote.blog/' },
  { '@type': 'ListItem', position: 2, name: page.title, item: abs(page.path) } ] });
%>
<div class="wrap"><nav class="crumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span aria-current="page"><%= page.title %></span></nav></div>
<section class="page-hero">
  <div class="wrap">
    <h1><%= page.h1 || page.title %></h1>
    <% if (page.description) { %><p class="lead"><%= page.description %></p><% } %>
    <% if (page.updated) { %><p class="muted">最后更新：<%= page.updated.format('YYYY-MM-DD') %></p><% } %>
  </div>
</section>
<div class="wrap narrow">
  <div class="prose"><%- page.content %></div>
</div>
