<%
const a = locals.a;
const regs = airport_regions(a);
const lines = airport_lines(a);
const mm = a.derived.minMonthly;
%>
<article class="a-card" data-airport
  data-name="<%= [a.name, a.englishName].concat(a.aliases || []).filter(Boolean).join(' ').toLowerCase() %>"
  data-regions="<%= regs.join(',') %>" data-lines="<%= lines.join(',') %>" data-min="<%= mm ? mm.price : '' %>" data-maxgb="<%= a.derived.maxMonthlyGB || '' %>" data-rank="<%= a.rank %>">
  <div class="a-top">
    <span class="a-rank" aria-label="编辑顺序第 <%= a.rank %>">#<%= String(a.rank).padStart(2, '0') %></span>
  </div>
  <h3 class="a-name"><a href="/airports/<%= a.slug %>/"><%= a.name %></a><% if (a.englishName) { %> <small><%= a.englishName %></small><% } %></h3>
  <p class="a-pos"><%= a.positioning %></p>
  <dl class="a-facts">
    <div><dt>月付起价</dt><dd><% if (mm) { %><strong><%= yuan(mm.price) %></strong> <span class="muted">/ <%= mm.plan %> · <%= gb(mm.gb) %></span><% } else { %>未提供<% } %></dd></div>
    <div><dt>节点地区</dt><dd><%= regs.slice(0, 5).join(' · ') %><% if (regs.length > 5) { %> +<%= regs.length - 5 %><% } %></dd></div>
    <div><dt>线路</dt><dd><%= lines.length ? lines.join(' / ') : '未提供' %></dd></div>
  </dl>
  <div class="a-actions">
    <a class="btn btn-soft" href="/airports/<%= a.slug %>/">查看详情 <svg class="ic"><use href="#i-arrow"/></svg></a>
    <% if (a.referralUrl) { %><a class="btn btn-ghost" href="<%= a.referralUrl %>" target="_blank" rel="sponsored nofollow noopener noreferrer">访问官网 <svg class="ic"><use href="#i-ext"/></svg></a>
    <% } else if (a.officialUrl) { %><a class="btn btn-ghost" href="<%= a.officialUrl %>" target="_blank" rel="nofollow noopener noreferrer">官网 <svg class="ic"><use href="#i-ext"/></svg></a><% } %>
  </div>
</article>
