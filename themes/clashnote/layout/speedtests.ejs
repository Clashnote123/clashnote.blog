<%
const records = site.data.speedtests || [];
const A = site.data.airports;
page.extraHead = jsonld({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashnote.blog/' },
  { '@type': 'ListItem', position: 2, name: '节点测速', item: 'https://clashnote.blog/speedtests/' } ] });
%>
<div class="wrap"><nav class="crumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span aria-current="page">节点测速</span></nav></div>
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">节点测速专区</p>
    <h1>节点测速：方法、口径与凭证</h1>
    <p class="lead">一张测速图只能说明那一次、那个节点、那条网络上的结果。本页先讲清怎么测、怎么读，再陈列有凭证的记录。</p>
  </div>
</section>
<div class="wrap">
  <section class="section-tight">
    <h2>本站当前的测速状态</h2>
    <div class="callout callout-mid">
      <p><strong>目前收录 <%= records.length %> 条站长提供的测速记录（灵动云，2026-11-09）。</strong>记录来自测试者提供的截图汇总图，<strong>本站未独立复测</strong>，且只有一次、一个时段的样本，因此不排名、不评分，也不与其他机场比较。下面逐项列出已有信息与缺失项。</p>
    </div>
  </section>

  <section class="section-tight">
    <h2>四类指标不要混为一谈</h2>
    <div class="table-wrap"><table class="tbl">
      <thead><tr><th>指标</th><th>说明什么</th><th>不能说明什么</th></tr></thead>
      <tbody>
        <tr><td>TLS RTT / 延迟</td><td>到节点的往返时间，反映「反应快不快」</td><td>不代表下载速度，更不代表看视频是否流畅</td></tr>
        <tr><td>HTTPS 延迟</td><td>建立 HTTPS 请求的耗时，更接近网页打开体验</td><td>与带宽无关</td></tr>
        <tr><td>下载 / 上传 Mbps</td><td>吞吐能力，受时段、线路、本地宽带影响</td><td>单次结果不能代表长期稳定</td></tr>
        <tr><td>流媒体 / AI 可用性</td><td>某服务在测试时是否可访问</td><td>网络通不等于账号地区资格；一次通过不是长期保证</td></tr>
      </tbody>
    </table></div>
    <p>详细读图方法见 <a href="/posts/how-to-read-speedtest-images/">《如何正确阅读机场节点测速图》</a>。</p>
  </section>

  <section class="section-tight">
    <h2>一条合格的测速记录必须包含</h2>
    <ul class="bullets cols">
      <li>原始截图或导出文件（遮挡订阅地址与账号信息）</li><li>测速工具与版本</li><li>测试设备与客户端版本</li><li>运营商与接入方式（宽带 / 移动网络）</li>
      <li>测试日期与时段（是否晚高峰）</li><li>具体节点名称与地区</li><li>测速口径（延迟 / 下载 / 上传 / 流媒体 / AI）</li><li>样本次数与适用范围说明</li>
    </ul>
  </section>

  <% records.forEach(function(r){ const b = A.find(x => x.slug === r.brand); %>
  <section class="section-tight" id="<%= r.brand %>">
    <h2>测速记录：<a href="/airports/<%= r.brand %>/"><%= b.name %></a> · <%= r.time %></h2>
    <p class="muted"><%= r.timezone %>（<%= r.timeNote %>）。数据来源：<%= r.source %>；<%= r.verifiedBy %>。</p>
    <dl class="fact-grid">
      <div><dt>下载</dt><dd><%= r.download %> Mbps</dd></div>
      <div><dt>上传</dt><dd><%= r.upload %> Mbps</dd></div>
      <div><dt>延迟</dt><dd><%= r.latency %> ms</dd></div>
      <div><dt>抖动</dt><dd><%= r.jitter %> ms</dd></div>
      <div><dt>测速工具</dt><dd><%= r.tools.join('、') %></dd></div>
      <div><dt>测速服务器</dt><dd><%= r.server %></dd></div>
      <div><dt>出口 IP 信息</dt><dd><%= r.exit.location %>；<%= r.exit.network %>（<%= r.exit.asn %>）；<%= r.exit.tz %></dd></div>
      <div><dt>客户端当时选择的节点</dt><dd><%= r.selectedNode %></dd></div>
    </dl>
    <h3>客户端节点延迟范围（图中可见）</h3>
    <div class="table-wrap"><table class="tbl">
      <thead><tr><th>地区</th><th>延迟范围</th></tr></thead>
      <tbody><% r.nodeRanges.forEach(function(n){ %><tr><td><%= n.region %></td><td><%= n.range %></td></tr><% }) %></tbody>
    </table></div>
    <h3>网络连通性检测（IPCheck.ing，图中所示）</h3>
    <p class="muted"><%= r.connectivity.note %>。</p>
    <% r.connectivity.groups.forEach(function(g){ %><p><strong><%= g.name %>：</strong><%= g.items.join('；') %></p><% }) %>
    <figure class="shot">
      <a href="<%= r.image %>" target="_blank" rel="noopener"><img src="<%= r.image %>" alt="<%= r.imageAlt %>" width="1122" height="1402" loading="lazy"></a>
      <figcaption>图：灵动云测速与节点记录汇总图（测试者提供，点击查看大图）。图中完整 IP 已遮挡；本站未独立复测。</figcaption>
    </figure>
    <h3>阅读这条记录时要注意</h3>
    <ul class="bullets"><% r.caveats.forEach(function(c){ %><li><%= c %></li><% }) %></ul>
    <p class="muted"><strong>仍缺：</strong><%= r.missing.join('、') %>。读图方法见<a href="/posts/how-to-read-speedtest-images/">《如何正确阅读机场节点测速图》</a>。</p>
  </section>
  <% }) %>

  <% const list = hub_posts('speedtests'); if (list.length) { %>
  <section class="section-tight">
    <h2>相关文章</h2>
    <div class="post-grid"><% list.forEach(function(p){ %><%- partial('partials/post-card', { p: p }) %><% }) %></div>
  </section>
  <% } %>
</div>