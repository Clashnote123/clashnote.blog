<%
const groups = site.data.faq || [];
const flat = groups.reduce((a, g) => a.concat(g.items), []);
page.extraHead = jsonld({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: flat.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip_html_text(f.a) } })) })
  + jsonld({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashnote.blog/' },
  { '@type': 'ListItem', position: 2, name: '常见问题', item: 'https://clashnote.blog/faq/' } ] });
%>
<div class="wrap"><nav class="crumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span aria-current="page">常见问题</span></nav></div>
<section class="page-hero"><div class="wrap"><h1>Clash 与机场常见问题</h1><p class="lead"><%= page.description %></p></div></section>
<div class="wrap narrow">
  <nav class="faq-nav" aria-label="问题分类"><% groups.forEach(function(g, i){ %><a href="#g<%= i %>"><%= g.title %></a><% }) %></nav>
  <% groups.forEach(function(g, i){ %>
  <section class="section-tight" id="g<%= i %>">
    <h2><%= g.title %></h2>
    <div class="faq-list"><% g.items.forEach(function(f){ %><details id="<%= f.id %>"><summary><%= f.q %></summary><div class="faq-a"><%- f.a %></div></details><% }) %></div>
  </section>
  <% }) %>
</div>
