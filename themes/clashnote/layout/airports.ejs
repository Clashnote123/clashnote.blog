<%
const A = site.data.airports;
const byMin = A.slice().sort((x, y) => x.derived.minMonthly.price - y.derived.minMonthly.price);
const byGB = A.slice().sort((x, y) => (y.derived.maxMonthlyGB || 0) - (x.derived.maxMonthlyGB || 0));
const five = ['香港', '台湾', '日本', '新加坡', '美国'];
const allFive = A.filter(a => five.every(r => airport_regions(a).includes(r))).length;
const withOnce = A.filter(a => a.plans.onetime.length).length;
const le20 = A.filter(a => a.derived.minMonthly.price <= 20).length;
const allRegions = ['香港', '台湾', '日本', '新加坡', '美国', '韩国', '马来西亚', '英国', '德国', '法国', '日本'].filter((v, i, s) => s.indexOf(v) === i);
page.extraHead = jsonld({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首页', item: 'https://clashnote.blog/' },
  { '@type': 'ListItem', position: 2, name: '机场推荐', item: 'https://clashnote.blog/airports/' } ] });
%>
<div class="wrap"><nav class="crumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span aria-current="page">机场推荐</span></nav></div>
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">机场资料库</p>
    <h1>17 家机场资料：套餐、节点与 Clash 订阅获取指引</h1>
    <p class="lead">为了满足用户的网络连接需求，本站整理了 17 家机场的资料、套餐、节点与 Clash 订阅渠道，规格与价格取自各品牌提供的官方资料。机场顺序为固定的编辑顺序，不是性能排名；本站通过推广链接获得的佣金不影响你的购买价格。详见<a href="/about/">披露说明</a>。</p>
    <div class="sum-box">
      <h2>资料概览</h2>
      <ul class="sum-list">
        <li><strong><%= allFive %> / 17</strong> 家的资料都列出了香港、台湾、日本、新加坡、美国五个地区的节点。</li>
        <li>常规周期套餐的月付起价在 <strong><%= yuan(byMin[0].derived.minMonthly.price) %>（<%= byMin[0].name %>）至 <%= yuan(byMin[byMin.length - 1].derived.minMonthly.price) %>（<%= byMin[byMin.length - 1].name %>）</strong>之间，其中 <%= le20 %> 家起价不超过 ¥20。</li>
        <li>单档月流量最大的是 <strong><%= byGB[0].name %>（<%= gb(byGB[0].derived.maxMonthlyGB) %>）</strong>，其后是 <%= byGB[1].name %>、<%= byGB[2].name %>（均为 <%= gb(byGB[1].derived.maxMonthlyGB) %>）。</li>
        <li>全部 17 家都有年付小包，<%= withOnce %> 家提供不限时流量包；年付、不限时与月付套餐口径不同，不能直接比较。</li>
        <li><a href="/airports/lingdongyun/"><strong>灵动云</strong></a>（编辑顺序 #01）：<%= (((site.data.editorial || {}).lingdongyun) || {}).intro || A[0].positioning %> 月付起价 <%= yuan(A[0].derived.minMonthly.price) %>（<%= A[0].derived.minMonthly.plan %> · <%= gb(A[0].derived.minMonthly.gb) %>）。<a href="/airports/lingdongyun/">查看灵动云详情</a></li>
        <li>这些机场没有公开的订阅入口，Clash 订阅需通过官网客服渠道询问，流程见<a href="/posts/get-clash-subscription-from-support/">向机场客服索取 Clash 订阅</a>。</li>
      </ul>
      <p class="tiny">以上数字均由本站机场资料自动统计，实际价格以官网结算页为准。</p>
    </div>
    <p class="info-strip"><strong>想用 Clash 导入？</strong>这些机场没有公开的订阅入口，订阅需通过官网客服渠道询问。先读：<a href="/posts/airport-subscription-link-explained/">机场订阅链接是什么</a> · <a href="/posts/get-clash-subscription-from-support/">向客服索取 Clash 订阅</a> · <a href="/posts/how-to-choose-clash-airport/">Clash 机场怎么选</a>。</p>
  </div>
</section>

<div class="wrap">
  <form class="filters" id="airFilters" aria-label="筛选机场">
    <div class="f-row">
      <label class="f-field f-grow"><span>搜索品牌 / 别名</span><input type="search" id="fQ" placeholder="例如：灵动、flyv、V2云"></label>
      <label class="f-field"><span>节点地区</span>
        <select id="fRegion"><option value="">不限</option><% allRegions.forEach(function(r){ %><option value="<%= r %>"><%= r %></option><% }) %></select>
      </label>
      <label class="f-field"><span>月付起价</span>
        <select id="fBudget"><option value="">不限</option><option value="20">≤ ¥20</option><option value="25">≤ ¥25</option><option value="30">≤ ¥30</option></select>
      </label>
      <label class="f-field"><span>线路</span>
        <select id="fLine"><option value="">不限</option><option value="IEPL">IEPL</option><option value="IPLC">IPLC</option><option value="BGP">BGP</option></select>
      </label>
      <label class="f-field"><span>排序</span>
        <select id="fSort"><option value="rank">编辑顺序（默认）</option><option value="price">月付起价 低→高</option><option value="gb">最大月流量 高→低</option></select>
      </label>
    </div>
    <div class="f-bar"><p id="fCount" role="status" aria-live="polite">共 17 家</p><button type="button" class="btn btn-ghost" id="fReset">重置筛选</button></div>
  </form>

  <div class="a-grid" id="airGrid">
    <% A.forEach(function(a){ %><%- partial('partials/airport-card', { a: a }) %><% }) %>
  </div>
  <div class="empty" id="fEmpty" hidden><h3>没有符合条件的机场</h3><p>放宽条件，或点击「重置筛选」。注意：资料中没有的字段不会被当作符合。</p></div>
  <p class="note-line">选择思路见<a href="/posts/how-to-choose-clash-airport/">《Clash 机场怎么选》</a>。线路类型（IEPL / IPLC / BGP）的含义与读法见<a href="/posts/iepl-iplc-bgp-explained/">《IEPL、IPLC、BGP 机场线路有什么区别》</a>。月付起价指资料中常规周期套餐的最低月付价，不含限时活动、年付小包与不限时流量包；实际价格以结算页为准。按规则，本站通过推广链接会获得佣金，但并不影响你的购买价格。</p>
</div>
